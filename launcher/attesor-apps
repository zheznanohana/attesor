#!/bin/bash
# Wraps arm64-only apps in place so that double-clicking them runs them under Attesor.
#   attesor-apps [scan]         wrap every arm64-only app in /Applications and ~/Applications (default)
#   attesor-apps wrap X.app     wrap one app
#   attesor-apps restore X.app  undo: put the original app back
#   attesor-apps list           show wrapped apps
#   attesor-apps rewrap         re-create every launcher (after launch flags changed); skips running apps
#   attesor-apps fixdock        point Dock items kept from a running guest at its launcher (scan does this too)
# The launcher keeps the original's bundle identifier, so the Dock matches the running guest to a kept item.
# A wrapped X.app is a small launcher bundle with the app's icon plus an "arm" badge; the untouched original
# lives inside it at X.app/Contents/Resources/Original/X.app, so there is still only one icon.
set -uo pipefail
# resolve symlinks (~/bin/attesor-apps) to find badge.swift next to the real script
src="$0"
while [ -L "$src" ]; do l=$(readlink "$src"); case "$l" in /*) src=$l;; *) src=$(dirname "$src")/$l;; esac; done
HERE="$(cd "$(dirname "$src")" && pwd)"
ATTESOR="${ATTESOR:-$HOME/bin/attesor}"
BADGE="$HERE/bin/badge"
SCAN_DIRS=(${ATTESOR_SCAN_DIRS:-/Applications $HOME/Applications})
# bump when launchers must be regenerated (flags, Info.plist); scan rewraps older ones that are not running
LAUNCHER_VERSION=4

plist() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null; }
is_wrapped() { [ "$(plist "$1" AttesorWrapped)" = true ]; }

# prints why an app is not a candidate, or nothing if it is one
check() {
  local app=$1 exe archs
  is_wrapped "$app" && { echo "already wrapped"; return; }
  exe=$(plist "$app" CFBundleExecutable) || { echo "no executable"; return; }
  archs=$(lipo -archs "$app/Contents/MacOS/$exe" 2>/dev/null) || { echo "not Mach-O"; return; }
  case " $archs " in *" x86_64 "*) echo "runs natively"; return;; esac
  case " $archs " in *" arm64 "*) ;; *) echo "no arm64 slice ($archs)"; return;; esac
  [ -d "$app/Contents/_MASReceipt" ] && { echo "App Store app (FairPlay encrypted)"; return; }
  return 0
}

wrap() {
  local app=${1%/} name exe dir tmp flags
  name=$(basename "$app" .app)
  dir=$(dirname "$app")
  exe=$(plist "$app" CFBundleExecutable)
  [ -w "$dir" ] && [ -w "$app" ] || { echo "  ! $app: no write permission (try with sudo)"; return 1; }
  # Every app gets the GPU bridge (ATTESOR_APPS_GPU=0 when wrapping: no GPU, software rendering).
  # Electron/Chromium apps also need --no-sandbox, and ANGLE refuses Metal on NVIDIA unless
  # disableMetalOnNvidia is overridden; only their GPU process gets the bridge.
  local gpu=1; [ "${ATTESOR_APPS_GPU:-1}" = 0 ] && gpu=0
  if [ -d "$app/Contents/Frameworks/Electron Framework.framework" ] || [ -d "$app/Contents/Frameworks/Chromium Embedded Framework.framework" ]; then
    if [ $gpu = 1 ]; then
      flags='--gpu --gpu-only --type=gpu-process "$EXE" --no-sandbox --disable-gpu-sandbox --disable-gpu-watchdog --use-angle=metal --use-gl=angle --enable-gpu --ignore-gpu-blocklist --disable-angle-features=disableMetalOnNvidia'
    else
      flags='"$EXE" --no-sandbox --disable-gpu'
    fi
  elif [ $gpu = 1 ]; then
    flags='--gpu "$EXE"'
  else
    flags='"$EXE"'
  fi

  tmp="$dir/.${name}.attesor-tmp.app"
  rm -rf "$tmp"
  mkdir -p "$tmp/Contents/MacOS" "$tmp/Contents/Resources/Original"
  cat > "$tmp/Contents/MacOS/launch" <<EOF
#!/bin/bash
# generated by attesor-apps; runs the arm64 original under Attesor
APP="\$(cd "\$(dirname "\$0")/../Resources/Original" && pwd)/${name}.app"
EXE="\$APP/Contents/MacOS/${exe}"
LOG="\$HOME/Library/Logs/Attesor/${name}.log"
mkdir -p "\$(dirname "\$LOG")"
# keep the log bounded: past 5 MB the old one becomes .1
[ -f "\$LOG" ] && [ \$(stat -f %z "\$LOG") -gt 5242880 ] && mv -f "\$LOG" "\$LOG.1"
cd "\$APP/Contents/MacOS"
echo "=== \$(date) ===" >> "\$LOG"
# every guest process also copies its stderr to ~/Library/Logs/Attesor/stderr/ (helpers' stderr is often piped away)
ATTESOR_STDERR_LOG=1 "${ATTESOR}" ${flags} "\$@" >> "\$LOG" 2>&1
rc=\$?
if [ \$rc -ne 0 ]; then
  osascript -e "display alert \"${name} 在 Attesor 下退出（代码 \${rc}）\" message \"日志：\${LOG}\"" >/dev/null
fi
EOF
  chmod 755 "$tmp/Contents/MacOS/launch"
  cat > "$tmp/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>${name}</string>
  <key>CFBundleDisplayName</key><string>${name}</string>
  <key>CFBundleIdentifier</key><string>$(plist "$app" CFBundleIdentifier || echo "attesor.wrapped.$name")</string>
  <key>CFBundleShortVersionString</key><string>$(plist "$app" CFBundleShortVersionString)</string>
  <key>CFBundleVersion</key><string>$(plist "$app" CFBundleVersion)</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSUIElement</key><true/>
  <key>AttesorWrapped</key><true/>
  <key>AttesorLauncherVersion</key><integer>${LAUNCHER_VERSION}</integer>
</dict></plist>
EOF
  "$BADGE" "$app" "$tmp/Contents/Resources/AppIcon.icns" || echo "  (icon failed, using default)"

  # swap: original goes inside the launcher, launcher takes the original's place
  if ! mv "$app" "$tmp/Contents/Resources/Original/${name}.app"; then rm -rf "$tmp"; echo "  ! could not move $app"; return 1; fi
  if ! mv "$tmp" "$app"; then mv "$tmp/Contents/Resources/Original/${name}.app" "$app"; rm -rf "$tmp"; echo "  ! could not install launcher"; return 1; fi
  touch "$app"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app" 2>/dev/null
  echo "  + wrapped $app"
}

restore() {
  local app=${1%/} name tmp
  is_wrapped "$app" || { echo "$app is not wrapped"; return 1; }
  name=$(basename "$app" .app)
  tmp="$(dirname "$app")/.${name}.attesor-restore.app"
  mv "$app/Contents/Resources/Original/${name}.app" "$tmp" || return 1
  rm -rf "$app" && mv "$tmp" "$app"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app" 2>/dev/null
  echo "  - restored $app"
}

each_app() { local d a; for d in "${SCAN_DIRS[@]}"; do for a in "$d"/*.app "$d"/*/*.app; do [ -d "$a" ] && echo "$a"; done; done; }

[ -x "$BADGE" ] || { mkdir -p "$HERE/bin"; swiftc -O "$HERE/badge.swift" -o "$BADGE" || exit 1; }
case "${1:-scan}" in
  scan)
    n=0
    while IFS= read -r app; do
      [ -z "$(check "$app")" ] || continue
      echo "arm64-only: $app"; wrap "$app" && n=$((n+1))
    done < <(each_app)
    while IFS= read -r app; do
      is_wrapped "$app" && [ "$(plist "$app" AttesorLauncherVersion)" != "$LAUNCHER_VERSION" ] || continue
      pgrep -f "$app/Contents/Resources/Original/" >/dev/null && continue   # running: next scan
      echo "outdated launcher: $app"; restore "$app" >/dev/null && wrap "$app" && n=$((n+1))
    done < <(each_app)
    [ $n -gt 0 ] && echo "$(date '+%F %T') done, $n app(s) wrapped"   # quiet when nothing changed (runs every 30 s)
    # per-process stderr copies: keep three days
    find "$HOME/Library/Logs/Attesor/stderr" -name '*.log' -mtime +3 -delete 2>/dev/null
    /usr/bin/python3 -I "$HERE/fix-dock.py" ;;
  fixdock) /usr/bin/python3 -I "$HERE/fix-dock.py" ;;
  wrap)
    why=$(check "${2%/}"); [ -z "$why" ] || { echo "${2}: $why"; exit 1; }
    wrap "$2" ;;
  restore) restore "$2" ;;
  list) while IFS= read -r app; do is_wrapped "$app" && echo "$app"; done < <(each_app) ;;
  rewrap)
    while IFS= read -r app; do
      is_wrapped "$app" || continue
      if pgrep -f "$app/Contents/Resources/Original/" >/dev/null; then echo "  ! $app is running, quit it and rerun"; continue; fi
      restore "$app" >/dev/null && wrap "$app"
    done < <(each_app) ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
