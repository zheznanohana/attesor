#!/usr/bin/python3 -I
"""Make ARM-only apps launch under Attesor by adding an x86-64 stub slice.

attesor-apps [scan | inject APP | restore APP | list | reinject | fixdock]
Aliases: wrap=inject, rewrap=reinject. ATTESOR_SCAN_DIRS is colon-separated.
ATTESOR_PROCESS_CHECK may name a checker: APP argument, 0=running, 1=stopped,
other=unknown. Unknown status always blocks modification. ATTESOR_NO_DESKTOP=1
skips icons/LaunchServices/Dock integration (for isolated automated tests).
"""
import ctypes
import fcntl
import hashlib
import os
from pathlib import Path
import plistlib
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = Path(__file__).resolve().parent
SUPPORT = Path.home() / 'Library/Application Support/Attesor'
STUB = HERE / 'bin/attesor-stub'
STUB_MARK = b'ATTESOR_STUB_V2'
LSREGISTER = '/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister'
DESKTOP = os.environ.get('ATTESOR_NO_DESKTOP') != '1'


def run(command, **kwargs):
    return subprocess.run([str(a) for a in command], check=True, capture_output=True, **kwargs)


def info(app):
    with (app / 'Contents/Info.plist').open('rb') as f:
        return plistlib.load(f)


def main_exe(app):
    name = info(app).get('CFBundleExecutable', '')
    if not name or Path(name).name != name:
        raise ValueError('invalid bundle executable')
    exe = app / 'Contents/MacOS' / name
    if exe.is_symlink():
        raise ValueError('symlinked bundle executable is not modified')
    return exe


def wrapped(app):
    return info(app).get('AttesorWrapped') is True


def arches(exe):
    return run(['lipo', '-archs', exe], text=True).stdout.split()


def marker(exe, value=b'ATTESOR_STUB_V'):
    # Only the x86 slice identifies our launcher. A coincidental guest string
    # must never authorize removing a genuine native x86 slice.
    if 'x86_64' not in arches(exe):
        return False
    return value in slice_bytes(exe, 'x86_64')


def slice_bytes(exe, arch):
    # lipo -remove may leave a fat container with one architecture. Architecture
    # count alone does not tell us whether the file is actually thin.
    with exe.open('rb') as f:
        magic = f.read(4)
    if magic in [b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe', b'\xfe\xed\xfa\xcf', b'\xfe\xed\xfa\xce']:
        if arches(exe) != [arch]:
            raise ValueError('requested architecture is missing')
        return exe.read_bytes()
    with tempfile.TemporaryDirectory(prefix='attesor-slice-') as td:
        out = Path(td) / 'slice'
        run(['lipo', exe, '-thin', arch, '-output', out])
        return out.read_bytes()


def require_stopped(app):
    checker = os.environ.get('ATTESOR_PROCESS_CHECK')
    if checker:
        result = subprocess.run([checker, str(app)], capture_output=True)
    else:
        # pgrep takes a regex; escape all app-path punctuation.
        pattern = re.escape(str(app)) + r'/Contents/(MacOS/|Resources/Original/)'
        result = subprocess.run(['/usr/bin/pgrep', '-f', pattern], capture_output=True)
    if result.returncode == 0:
        raise ValueError('application is running; retry after it exits')
    if result.returncode != 1:
        raise ValueError('cannot determine whether application is running; unchanged')


def backup_dir(app):
    # Different apps can share an identifier. Bind restoration to canonical path.
    return SUPPORT / 'originals' / hashlib.sha256(os.fsencode(app)).hexdigest()


def kept_original(app):
    current = backup_dir(app) / 'executable'
    if current.exists():
        return current
    # Older launcher releases keyed backups by bundle id. Only use one when
    # its recorded canonical path matches; otherwise equal ids are ambiguous.
    ident = info(app).get('CFBundleIdentifier', app.stem)
    if Path(ident).name == ident:
        legacy = SUPPORT / 'originals' / ident
        try:
            if Path((legacy / 'path').read_text().strip()).resolve() == app:
                return legacy / main_exe(app).name
        except OSError:
            pass
    return current


def atomic_copy(source, target):
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='.' + target.name + '.', dir=target.parent)
    os.close(fd)
    try:
        shutil.copy2(source, temp)
        os.replace(temp, target)
    finally:
        Path(temp).unlink(missing_ok=True)


def finish(app, inject_icon=False):
    if not DESKTOP:
        return
    if inject_icon:
        ident = info(app).get('CFBundleIdentifier')
        if ident and Path(ident).name == ident:
            dest = SUPPORT / 'icons' / (ident + '.icns')
            dest.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run([str(HERE / 'bin/badge'), str(app), str(dest)], capture_output=True)
    os.utime(app, None)
    subprocess.run([LSREGISTER, '-f', str(app)], capture_output=True)


def ensure_tools():
    STUB.parent.mkdir(parents=True, exist_ok=True)
    # Rebuild when source changed; an old executable alone is insufficient.
    source = HERE / 'stub.c'
    if not STUB.exists() or STUB_MARK not in STUB.read_bytes() or STUB.stat().st_mtime < source.stat().st_mtime:
        temp = STUB.with_suffix('.new')
        run(['clang', '-O2', '-arch', 'x86_64', '-mmacosx-version-min=10.15', source, '-o', temp])
        run(['codesign', '-s', '-', '-f', temp])
        os.replace(temp, STUB)
    if DESKTOP and not (HERE / 'bin/badge').exists():
        run(['swiftc', '-O', HERE / 'badge.swift', '-o', HERE / 'bin/badge'])


def inject(app):
    require_stopped(app)
    if wrapped(app):
        unwrap(app, checked=True)
    if (app / 'Contents/_MASReceipt').exists():
        raise ValueError('App Store application is not modified')
    exe = main_exe(app)
    archs = arches(exe)
    if 'x86_64' in archs:
        if marker(exe, STUB_MARK):
            return False
        if not marker(exe):
            raise ValueError('application runs natively')
        # Upgrade only our x86 slice, retaining the current ARM slice(s).
        restore(app, checked=True, finalize=False)
        exe = main_exe(app)
        archs = arches(exe)
    if 'arm64' not in archs:
        raise ValueError('no arm64 slice')
    original = {a: slice_bytes(exe, a) for a in archs}
    bdir = backup_dir(app)
    atomic_copy(exe, bdir / 'executable')
    (bdir / 'path').write_text(str(app) + '\n')
    fd, name = tempfile.mkstemp(prefix='.' + exe.name + '.attesor-', dir=exe.parent)
    os.close(fd)
    temp = Path(name)
    try:
        run(['lipo', '-create', STUB, exe, '-output', temp])
        if any(slice_bytes(temp, a) != bits for a, bits in original.items()):
            raise ValueError('ARM slice changed while preparing launcher')
        shutil.copystat(exe, temp)
        os.replace(temp, exe)
    finally:
        temp.unlink(missing_ok=True)
    if DESKTOP:
        for path in [app, exe]:
            subprocess.run(['xattr', '-d', 'com.apple.quarantine', str(path)], capture_output=True)
    finish(app, inject_icon=True)
    print('  +', app)
    return True


def restore(app, checked=False, finalize=True):
    if not checked:
        require_stopped(app)
    if wrapped(app):
        unwrap(app, checked=True)
        return True
    exe = main_exe(app)
    if not marker(exe):
        raise ValueError('application is not handled by Attesor')
    remaining = [a for a in arches(exe) if a != 'x86_64']
    before = {a: slice_bytes(exe, a) for a in remaining}
    fd, name = tempfile.mkstemp(prefix='.' + exe.name + '.attesor-', dir=exe.parent)
    os.close(fd)
    temp = Path(name)
    try:
        run(['lipo', exe, '-remove', 'x86_64', '-output', temp])
        if len(remaining) == 1:
            bits = slice_bytes(temp, remaining[0])
            temp.write_bytes(bits)
        # An exact original restores file layout/signature too. Never roll back
        # an ARM update installed after injection.
        kept = kept_original(app)
        if kept.exists() and arches(kept) == remaining and all(slice_bytes(kept, a) == bits for a, bits in before.items()):
            shutil.copyfile(kept, temp)
        if any(slice_bytes(temp, a) != bits for a, bits in before.items()):
            raise ValueError('ARM slice changed while preparing restore')
        shutil.copystat(exe, temp)
        os.replace(temp, exe)
    finally:
        temp.unlink(missing_ok=True)
    if finalize:
        ident = info(app).get('CFBundleIdentifier')
        if DESKTOP and ident and Path(ident).name == ident:
            (SUPPORT / 'icons' / (ident + '.icns')).unlink(missing_ok=True)
        finish(app)
        print('  - restored', app)
    return True


def unwrap(app, checked=False):
    if not checked:
        require_stopped(app)
    inner = app / 'Contents/Resources/Original' / app.name
    if not inner.is_dir():
        raise ValueError('old launcher has no original application')
    # Prepare a complete copy first. RENAME_SWAP makes the final directory
    # replacement atomic; a failed copy/swap leaves the old wrapper intact.
    # The inner bundle shares the app's identifier: left registered, the Dock may resolve the app's
    # tile to that arm64-only record and draw it "prohibited".
    if DESKTOP:
        subprocess.run([LSREGISTER, '-u', str(inner)], capture_output=True)
    stage = Path(tempfile.mkdtemp(prefix='.' + app.stem + '.attesor-', dir=app.parent))
    shutil.rmtree(stage)
    try:
        shutil.copytree(inner, stage, symlinks=True)
        lib = ctypes.CDLL(None, use_errno=True)
        rename = lib.renamex_np
        rename.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
        rename.restype = ctypes.c_int
        if rename(os.fsencode(app), os.fsencode(stage), 0x2) != 0:  # RENAME_SWAP, sys/stdio.h
            raise OSError(ctypes.get_errno(), 'could not atomically replace old wrapper')
        finish(app)
    finally:
        if stage.exists():
            shutil.rmtree(stage)


def forget_stale_inner():
    """Once: unregister LaunchServices records of old launchers' inner bundles that no longer exist
    (left by conversions before unwrap unregistered them)."""
    done = SUPPORT / 'ls-inner-forgotten'
    if not DESKTOP or done.exists():
        return
    dump = subprocess.run([LSREGISTER, '-dump'], capture_output=True, text=True, errors='replace').stdout
    for m in re.finditer(r'^path:\s+(.+/Contents/Resources/Original/.+?\.app) \(0x[0-9a-f]+\)$', dump, re.M):
        if not Path(m.group(1)).exists():
            subprocess.run([LSREGISTER, '-u', m.group(1)], capture_output=True)
            print('  ~ unregistered stale', m.group(1))
    done.write_text('1\n')


def each_app():
    dirs = os.environ.get('ATTESOR_SCAN_DIRS')
    roots = [Path(p) for p in dirs.split(':') if p] if dirs else [Path('/Applications'), Path.home() / 'Applications']
    return sorted({a.resolve() for root in roots for pattern in ['*.app', '*/*.app'] for a in root.glob(pattern) if a.is_dir()})


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else 'scan'
    command = {'wrap': 'inject', 'rewrap': 'reinject'}.get(command, command)
    if command not in ['scan', 'inject', 'restore', 'list', 'reinject', 'fixdock']:
        print(__doc__, file=sys.stderr)
        return 2
    if command in ['inject', 'restore'] and len(sys.argv) != 3:
        print('usage: attesor-apps ' + command + ' APP', file=sys.stderr)
        return 2
    if command == 'fixdock':
        return subprocess.call(['/usr/bin/python3', '-I', str(HERE / 'fix-dock.py')]) if DESKTOP else 0
    SUPPORT.mkdir(parents=True, exist_ok=True)
    with (SUPPORT / 'launcher.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if command != 'list':
            ensure_tools()
        apps = [Path(sys.argv[2]).resolve()] if command in ['inject', 'restore'] else each_app()
        failed = False
        for app in apps:
            try:
                if command == 'list':
                    if wrapped(app) or marker(main_exe(app)):
                        print(app)
                elif command == 'restore':
                    restore(app)
                elif command in ['scan', 'reinject']:
                    try:
                        old_launcher = wrapped(app)
                        exe = None if old_launcher else main_exe(app)
                    except (OSError, ValueError, plistlib.InvalidFileException):
                        continue  # no usable Info.plist / executable (e.g. a symlinked one): not a candidate
                    if old_launcher:
                        inject(app)
                        continue
                    try:
                        archs = arches(exe)
                    except subprocess.CalledProcessError:
                        continue  # script-based/non-Mach-O applications need no stub
                    handled = 'x86_64' in archs and marker(exe)
                    if 'arm64' not in archs or (app / 'Contents/_MASReceipt').exists():
                        continue
                    if command == 'reinject' and not handled:
                        continue
                    if command == 'scan' and (('x86_64' in archs and not handled) or (handled and marker(exe, STUB_MARK))):
                        continue
                    inject(app)
                else:
                    inject(app)
            except (OSError, ValueError, subprocess.CalledProcessError) as e:
                print(f'  ! {app}: {e}', file=sys.stderr)
                failed = True
        if command == 'scan':
            forget_stale_inner()
            logs = Path.home() / 'Library/Logs/Attesor/stderr'
            cutoff = time.time() - 3 * 86400
            for log in logs.glob('*.log'):
                try:
                    if log.is_file() and not log.is_symlink() and log.stat().st_mtime < cutoff:
                        log.unlink()
                except OSError:
                    pass
        # No Dock restart is needed for every scan. Explicit fixdock is available
        # for repairing legacy pinned items, with its own running-process guard.
        return 1 if failed else 0


if __name__ == '__main__':
    raise SystemExit(main())
